FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY . .
ARG MODULE
RUN mvn -B -DskipTests -pl "${MODULE}" -am package

FROM eclipse-temurin:17-jre
WORKDIR /app
ARG MODULE
COPY --from=build "/workspace/${MODULE}/target/"*.jar /app/app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
